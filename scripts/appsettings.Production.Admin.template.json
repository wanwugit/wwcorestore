{
  // ============================================================
  // CoreCms.Net.Web.Admin 生产配置模板 (appsettings.Production.json)
  // ------------------------------------------------------------
  // 用法：
  //   1. 复制本文件到 CoreCms.Net.Web.Admin/ 目录，重命名为 appsettings.Production.json
  //   2. 搜索全部 <FILL_...> 占位符，逐项替换为真实值
  //   3. 启动前必须设环境变量 ASPNETCORE_ENVIRONMENT=Production
  //   4. 切勿提交本文件到 git (.gitignore 已排除)
  //
  // 注意：Admin 不启用 SwaggerBasicAuth 中间件（Program.cs 硬编码 RoutePrefix="doc"）
  //       故不校验 SwaggerConfig:UserName/PassWord
  //       JwtConfig:SecretKey + Issuer 应与 WebApi 保持一致（用同一套 JWT 签名）
  // ============================================================
  "ConnectionStrings": {
    "DbType": "SqlServer",   // 与 WebApi 一致
    "SqlConnection": "<FILL_数据库连接串_同WebApi>"
  },
  "HangFire": {
    // Admin 自己也读 HangFire 节，可不与 WebApi 相同
    "Login": "<FILL_自定义Hangfire登录名>",
    "PassWord": "<FILL_自定义Hangfire密码>"
  },
  "AppConfig": {
    "AppUrl": "<FILL_后端管理URL_如_https_admin_yourshop_com>",
    "AppInterFaceUrl": "<FILL_API接口URL_如_https_api_yourshop_com>"
  },
  "Distribution": {
    "CommissionSettleEnabled": "0"
  },
  "RedisConfig": {
    "UseCache": true,
    "UseTimedTask": true,
    "ConnectionString": "<FILL_Redis连接串_与WebApi可共用同一实例>"
  },
  "JwtConfig": {
    // ★ 与 WebApi appsettings.Production.json 的 JwtConfig 保持一致
    "SecretKey": "<FILL_JWT签名密钥_与WebApi完全相同>",
    "Issuer": "<FILL_JWT颁发者_与WebApi完全相同>",
    "Audience": "coreshop"
  },
  "Cors": {
    "PolicyName": "CorsIpAccess",
    "EnableAllIPs": false,
    "IPs": "<FILL_跨域白名单_逗号分隔_Admin后台域名>"
  },
  "Middleware": {
    "RequestResponseLog": { "Enabled": false },
    "RecordAccessLogs": { "Enabled": false, "IgnoreApis": "/api/Home/GetNav,/api/Home/GetIds4Users" },
    "IPLog": { "Enabled": false }
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft": "Warning",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "AllowedHosts": "*",
  "YiLianYunConfig": {
    "Enabled": false,
    "ClientId": "",
    "ClientSecret": "",
    "MachineCode": "",
    "Msign": "",
    "PrinterName": "",
    "Phone": ""
  },
  "WeChatPay": {
    "AppId": "",
    "MchId": "",
    "APIKey": "",
    "APIv3Key": "",
    "Certificate": "WxPayCert\\apiclient_cert.p12",
    "RsaPublicKey": ""
  },
  "Alipay": {
    "AppId": "",
    "AlipayPublicKey": "",
    "AppPrivateKey": "",
    "ServerUrl": "https://openapi.alipay.com/gateway.do",
    "SignType": "RSA2",
    "AppPublicCert": "",
    "AlipayPublicCert": "",
    "AlipayRootCert": ""
  },
  "PayCallBack": {
    "WeChatPayUrl": "<FILL_微信支付回调URL_同WebApi>",
    "WeChatRefundUrl": "<FILL_微信退款回调URL_同WebApi>",
    "AlipayUrl": "",
    "AlipayRefundUrl": ""
  },
  "WeChatOptions": {
    "WeiXinAppId": "",
    "WeiXinAppSecret": "",
    "EncodingAESKey": "",
    "Token": "",
    // ★ 与 WebApi 保持一致（小程序前端共用同一 AppId 登录）
    "WxOpenAppId": "<FILL_微信小程序AppId_与WebApi一致>",
    "WxOpenAppSecret": "<FILL_微信小程序AppSecret_与WebApi一致>",
    "WxOpenToken": "<FILL_自定义Token_与WebApi一致>",
    "WxOpenEncodingAESKey": "<FILL_43位随机AESKey_与WebApi一致>"
  }
}